# Oracle keeper config — copy to a local .env or set as Fly runtime secrets.

# Runtime-private Helius devnet RPC URL dedicated to the keeper. Do not reuse
# the browser, indexer, or demo-fleet credential.
RPC_URL=https://devnet.helius-rpc.com/?api-key=KEEPER_KEY

# Devnet default: read the free sponsored Pyth SOL/BTC/ETH shard-0 accounts
# directly from the keeper RPC. This needs no Pyth API credential. It validates
# the exact receiver owner, feed ID, Full verification, confidence, and a
# maximum 300-second source age before creating a fresh AuthMark.
# PYTH_PRICE_SOURCE=solana-push
# PYTH_PUSH_MAX_AGE_SECS=300
# PYTH_PUSH_MAX_CONFIDENCE_BPS=100

# Explicit dev/test alternative: read MagicBlock's public real-time SOL/BTC/ETH
# demo accounts through the pinned credential-free MagicBlock devnet endpoint.
# The keeper verifies the exact program owner, feed addresses, deployed account
# shape, discriminator, Full marker, magnitude exponent, freshness and bounds.
# This public demo has no documented production SLA and is never the default.
# ORACLE_PRICE_SOURCE=magicblock-demo
# MAGICBLOCK_DEMO_MAX_AGE_SECS=60

# Optional paid/future source: authenticated Hermes. Select it explicitly and
# enter the server-only Terminal credential. Never expose this through
# NEXT_PUBLIC_* or put it in a URL.
# PYTH_PRICE_SOURCE=hermes
# PYTH_API_KEY=ENTER_LOCALLY

# Optional credential-free HTTPS endpoint override for Hermes mode. The
# authenticated Core endpoint below is already the code default.
# PYTH_HERMES_URL=https://hermes.pyth.network

# Program/market defaults point at the live v16 deployment; usually leave unset.
# PROGRAM_ID=
# MARKET=
# LP_PORTFOLIO=

# Warning floor for matcher risk capital. This never funds or mutates the LP;
# it only controls explicit keeper health diagnostics (default: 10000 USDC).
# LP_MIN_CAPITAL_USDC=10000

# Recovery continues until every active/drain-only asset clock is within this
# many market slots. Keep aligned with the independent auditor (default: 300).
# MARKET_MAX_CLOCK_LAG_SLOTS=300

# The standalone auditor defaults to the strict recovered-snapshot profile.
# Protected continuous releases select operational and provide reviewed floors
# as workflow inputs; do not persist release-specific floor choices as secrets.
# AUDIT_PROFILE=recovery
# LP_MIN_RISK_EQUITY_USDC=100000
# EXPECTED_DOMAIN_INSURANCE_USDC=100000
# MIN_DOMAIN_INSURANCE_USDC=80000
# REQUIRE_AUTHORITY_PARITY=true

# Existing Solana oracle-authority signer, encoded as a JSON array or base64.
# This is not a Helius key. Keep it out of source and never substitute the
# test-USDC mint authority or a browser credential.
KEEPER_SECRET_KEY=[...]

# --- legacy (used by other CLI scripts, not the keeper) ---
# SOLANA_RPC_URL=https://api.devnet.solana.com
# WALLET_PATH=~/.config/solana/id.json
