# Oracle keeper config — copy to Railway env vars (or a local .env for dev)

# Dedicated devnet RPC (Helius / QuickNode). The public endpoint gets rate-limited.
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_KEY

# Program (default is the deployed checkpoint-v2 program; usually leave unset)
# PROGRAM_ID=F9ve3CUdJyeXS2Rjq3VSbFb7pfbehB5eWfWMpKRco3QS

# Oracle-authority secret key. On a host there is no local keypair file, so
# paste the deployer key here — either the JSON array from the keypair file
# (e.g. [12,34,...]) or a base64 of that array.
#   cat ~/.config/solana/mukon-deployer.json          -> JSON array form
#   base64 -i ~/.config/solana/mukon-deployer.json    -> base64 form
KEEPER_SECRET_KEY=[...]

# Single-market override (optional). When set, the keeper only pushes this
# slab and uses FEED_ID for its price. Unset = push all three (SOL/BTC/ETH).
# SLAB=
# FEED_ID=

# --- legacy (used by other CLI scripts, not the keeper) ---
# SOLANA_RPC_URL=https://api.devnet.solana.com
# WALLET_PATH=~/.config/solana/id.json
