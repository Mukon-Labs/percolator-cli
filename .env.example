# Oracle keeper config — copy to a local .env or set as Fly runtime secrets.

# Runtime-private Helius devnet RPC URL dedicated to the keeper. Do not reuse
# the browser, indexer, or demo-fleet credential.
RPC_URL=https://devnet.helius-rpc.com/?api-key=KEEPER_KEY

# Program/market defaults point at the live v16 deployment; usually leave unset.
# PROGRAM_ID=
# MARKET=
# LP_PORTFOLIO=

# Existing Solana oracle-authority signer, encoded as a JSON array or base64.
# This is not a Helius key. Keep it out of source and never substitute the
# test-USDC mint authority or a browser credential.
KEEPER_SECRET_KEY=[...]

# --- legacy (used by other CLI scripts, not the keeper) ---
# SOLANA_RPC_URL=https://api.devnet.solana.com
# WALLET_PATH=~/.config/solana/id.json
